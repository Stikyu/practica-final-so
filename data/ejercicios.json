    {
      "id": "sem-holas",
      "tipo": "semaforos",
      "titulo": "HOLAS / HOALS",
      "origen": "material",
      "fuente": {
        "archivo": "Unidad 4 - Sincronizacion de Procesos.pdf",
        "pagina": 46
      },
      "datos": {
        "enunciado": "P1 imprime H, L y S; P2 imprime O y A. Agregá semáforos (y sus valores iniciales) para que la salida sea siempre HOLAS u HOALS y nunca otra secuencia.",
        "programas": [
          "print(H)\nprint(L)\nprint(S)",
          "print(O)\nprint(A)"
        ],
        "permitidas": [
          "HOLAS",
          "HOALS"
        ],
        "solucion": {
          "programas": [
            "wait(S1)\nprint(H)\nsignal(S2)\nwait(S3)\nprint(L)\nwait(S4)\nprint(S)",
            "wait(S2)\nprint(O)\nsignal(S3)\nprint(A)\nsignal(S4)"
          ],
          "iniciales": "S1=1, S2=0, S3=0, S4=0"
        },
        "explicacion": "S1 = 1 deja arrancar a P1 con la H. Después de la H, signal(S2) habilita a P2 para la O. Después de la O, signal(S3) habilita la L de P1. La A de P2 puede salir antes o después de la L (por eso hay dos salidas válidas), pero la S tiene que esperar la A: P2 hace signal(S4) después de la A y P1 hace wait(S4) antes de la S."
      }
    },
    {
      "id": "sem-synch",
      "tipo": "semaforos",
      "titulo": "D2 solo después de D1",
      "origen": "material",
      "fuente": {
        "archivo": "Unidad 4 - Sincronizacion de Procesos.pdf",
        "pagina": 45
      },
      "datos": {
        "enunciado": "P1 ejecuta la declaración D1 y P2 la declaración D2. Hacé que D2 se ejecute siempre después de D1.",
        "programas": [
          "print(D1)",
          "print(D2)"
        ],
        "permitidas": [
          "D1 D2"
        ],
        "solucion": {
          "programas": [
            "print(D1)\nsignal(synch)",
            "wait(synch)\nprint(D2)"
          ],
          "iniciales": "synch=0"
        },
        "explicacion": "synch arranca en 0, así que P2 se bloquea en wait(synch) hasta que P1 termina D1 y hace signal(synch). Así D2 siempre se ejecuta después de D1."
      }
    }
